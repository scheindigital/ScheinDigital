---
// Sichtbare FAQ. Das passende Schema erzeugt die Seite mit faqSchema()
// aus derselben Liste, dadurch bleiben Text und Schema identisch.
import type { FaqItem } from "../data/site";

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = "Häufige Fragen." } = Astro.props;
---

<section id="faq" class="section faq">
  <p class="eyebrow">FAQ</p>
  <h2>{heading}</h2>

  <div class="faq-list">
    {items.map((f, i) => (
      <details class="faq-item" open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 14px;
    margin-top: 36px;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    padding: 24px 26px;
  }

  .faq-item summary {
    cursor: pointer;
    font-size: 1.15rem;
    font-weight: 850;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    float: right;
    color: #00d5d5;
    font-weight: 900;
  }

  .faq-item[open] summary::after {
    content: "–";
  }

  .faq-item p {
    margin-bottom: 0;
    max-width: 820px;
  }

  @media (max-width: 800px) {
    .faq-item {
      padding: 24px;
    }
  }
</style>
