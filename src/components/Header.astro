---
import { CAL_LINK } from "../data/site";

interface Props {
  nav?: { href: string; label: string }[];
}

// Standard-Navigation: Sprungmarken auf der Startseite.
// Mit "/" davor funktionieren sie auch von Unterseiten aus.
const DEFAULT_NAV = [
  { href: "/#leistungen", label: "Leistungen" },
  { href: "/#ablauf", label: "Ablauf" },
  { href: "/#ansprechpartner", label: "Ansprechpartner" },
  { href: "/#faq", label: "FAQ" },
];

const { nav = DEFAULT_NAV } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="ScheinDigital Startseite">
    <img class="brand-logo-img" src="/sd-logo.svg" alt="" />
    <span>ScheinDigital</span>
  </a>

  <nav class="nav" aria-label="Hauptnavigation">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <a class="header-cta" href={CAL_LINK} target="_blank" rel="noopener noreferrer">Erstgespräch buchen</a>
</header>

<style>
  .site-header {
    position: fixed;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: min(1120px, calc(100% - 40px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 999px;
    background: rgba(8, 8, 8, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(18px);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .nav a {
    color: #bdbdbd;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .nav a:hover {
    color: #00d5d5;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 11px 17px;
    background: #00d5d5;
    border: 1px solid #00d5d5;
    color: #050505;
    font-weight: 850;
    font-size: 0.92rem;
    white-space: nowrap;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .header-cta:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  @media (max-width: 1100px) {
    .nav {
      gap: 10px;
    }

    .nav a {
      font-size: 0.78rem;
    }

    .header-cta {
      padding: 10px 14px;
      font-size: 0.88rem;
    }
  }

  @media (max-width: 800px) {
    .site-header {
      top: 12px;
      width: min(100% - 28px, 1120px);
      padding: 10px 12px;
    }

    .nav {
      display: none;
    }

    .header-cta {
      padding: 10px 14px;
      font-size: 0.88rem;
    }
  }
</style>
