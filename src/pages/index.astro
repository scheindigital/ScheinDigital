    <script is:inline>
      // ============================================================
      //  Bestätigungs-Banner nach Double-Opt-In
      //  Wird angezeigt, wenn die URL ?newsletter=bestaetigt enthält
      //  (kommt von der Brevo-DOI-Weiterleitung)
      // ============================================================
      (function () {
        const params = new URLSearchParams(window.location.search);
        const banner = document.querySelector("#confirm-banner");
        if (params.get("newsletter") === "bestaetigt" && banner) {
          banner.classList.add("visible");
          // URL-Parameter sauber entfernen, damit das Banner bei Reload weg ist
          history.replaceState(null, "", window.location.pathname);
          // nach 8 Sekunden automatisch ausblenden
          setTimeout(() => banner.classList.remove("visible"), 8000);
        }
        document.querySelector("#confirm-banner-close")?.addEventListener("click", () => {
          banner?.classList.remove("visible");
        });
      })();

      // ============================================================
      //  Newsletter-Anmeldung -> n8n Webhook
      //  Trage unten deine n8n-Webhook-URL ein.
      //  (In n8n: Webhook-Node -> Methode POST -> Pfad z.B. /newsletter)
      // ============================================================
      const NEWSLETTER_WEBHOOK = "https://n8n.scheindigital.de/webhook/newsletter"; // <-- anpassen

      const nlForm = document.querySelector("#newsletter-form");
      const nlMsg = document.querySelector("#newsletter-msg");

      nlForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const email = new FormData(nlForm).get("email")?.toString().trim() || "";
        const consent = document.querySelector("#nl-consent")?.checked;
        if (!email) return;

        if (!consent) {
          nlMsg.textContent = "Bitte bestätige die Einwilligung, um fortzufahren.";
          nlMsg.className = "newsletter-msg error";
          return;
        }

        nlMsg.textContent = "Wird gesendet …";
        nlMsg.className = "newsletter-msg";

        try {
          const res = await fetch(NEWSLETTER_WEBHOOK, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              consent: true,
              consentText: "Newsletter-Einwilligung inkl. Datenschutzerklärung",
              source: "website-newsletter",
              timestamp: new Date().toISOString(),
            }),
          });

          if (!res.ok) throw new Error("Request failed");

          nlForm.reset();
          nlMsg.textContent = "Fast geschafft! Bitte bestätigen Sie den Link in Ihrer E-Mail.";
          nlMsg.className = "newsletter-msg ok";
        } catch (err) {
          nlMsg.textContent = "Da ist etwas schiefgelaufen. Bitte später erneut versuchen.";
          nlMsg.className = "newsletter-msg error";
        }
      });
    </script>
