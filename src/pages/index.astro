---
// =====================================================================
//  ScheinDigital – Startseite
//  EINSTELLUNGEN: Leistungen und FAQ werden hier zentral gepflegt.
//  Leistungen und FAQ erscheinen automatisch auf der Seite UND im
//  Schema-Markup, dadurch bleiben beide immer identisch.
//  Links, Adresse und Telefon stehen in src/data/site.ts.
// =====================================================================
import BaseLayout from "../layouts/BaseLayout.astro";
import ProcessSection from "../components/ProcessSection.astro";
import FaqSection from "../components/FaqSection.astro";
import CtaSection from "../components/CtaSection.astro";
import { ADDRESS, BUSINESS, CAL_LINK, PHONE, SITE_URL, faqSchema } from "../data/site";

// link: optionale Unterseite zur Leistung. Erst eintragen, wenn die Seite existiert.
const SERVICES: { problem: string; name: string; text: string; link?: { href: string; text: string } }[] = [
  {
    problem: "„Mich findet online keiner.“",
    name: "Bei Google gefunden werden",
    text: "Ich sorge dafür, dass Ihr Unternehmen bei Google und Google Maps auftaucht, wenn Kunden in Ihrer Region suchen.",
  },
  {
    problem: "„Meine Website bringt keine Anfragen.“",
    name: "Websites & Landingpages",
    text: "Ich baue Websites, die klar zeigen, was Sie anbieten, und Besucher zur Anfrage führen.",
    link: { href: "/webdesign", text: "Mehr zu Webdesign" },
  },
  {
    problem: "„Ich brauche schnell mehr Anfragen.“",
    name: "Google Ads & Werbeanzeigen",
    text: "Mit gezielten Anzeigen bei Google und in sozialen Netzwerken erreichen Sie schnell die Menschen, die zu Ihrem Angebot passen.",
    link: { href: "/werbeanzeigen", text: "Mehr zu Werbeanzeigen" },
  },
  {
    problem: "„Social Media kostet Zeit und bringt nichts.“",
    name: "Social Media Marketing",
    text: "Ich entwickle mit Ihnen einen Plan, der zu Ihrem Betrieb passt und Ihnen Zeit spart.",
    link: { href: "/social-media", text: "Mehr zu Social Media" },
  },
  {
    problem: "„Mein Auftritt wirkt nicht professionell.“",
    name: "Logo- & Werbedesign",
    text: "Logo, Flyer und Werbemittel, die auf den ersten Blick Vertrauen schaffen.",
  },
  {
    problem: "„Ich weiß nicht, wo ich anfangen soll.“",
    name: "Marketingberatung",
    text: "Im Erstgespräch sage ich Ihnen ehrlich, was sich für Sie lohnt und was nicht.",
  },
];

const FAQ = [
  {
    q: "Was passiert im kostenlosen Erstgespräch?",
    a: "Ich schaue mir mit Ihnen Ihre Website, Ihr Google-Profil und Ihren Anfrageweg an. Danach wissen Sie, wo Sie aktuell Kunden verlieren und was sich lohnt. Das Gespräch dauert rund 20 Minuten und ist unverbindlich.",
  },
  {
    q: "Muss ich danach direkt Kunde werden?",
    a: "Nein. Wenn eine Zusammenarbeit Sinn macht, sprechen wir offen darüber. Wenn nicht, haben Sie trotzdem eine ehrliche Einschätzung.",
  },
  {
    q: "Warum stehen keine festen Preise auf der Website?",
    a: "Weil jedes Unternehmen eine andere Ausgangslage hat. Nach dem Erstgespräch bekommen Sie ein klares Angebot, das zu Ihrem Bedarf passt.",
  },
  {
    q: "Für welche Unternehmen ist ScheinDigital geeignet?",
    a: "Für Handwerksbetriebe, Praxen, Restaurants, Autohäuser, Dienstleister und IT-Firmen, in Schortens, in der Region und deutschlandweit.",
  },
  {
    q: "Wie schnell sieht man Ergebnisse?",
    a: "Das hängt vom Bereich ab. Eine bessere Website wirkt sofort, Anzeigen bringen schnell Reichweite, die Sichtbarkeit bei Google braucht mehr Zeit.",
  },
];

const PROCESS = [
  { title: "Erstgespräch", text: "20 Minuten, kostenlos und unverbindlich." },
  { title: "Ehrliche Einschätzung", text: "Ich zeige Ihnen, wo es hakt und was die Lösung kostet." },
  { title: "Umsetzung", text: "Ich kümmere mich um alles, Sie konzentrieren sich auf Ihr Geschäft." },
];

const SCHEMA = [
  {
    "@context": "https://schema.org",
    ...BUSINESS,
    "description": "Marketingbüro & Marketingagentur in Schortens für Websites, Sichtbarkeit bei Google, Google Ads, Social Media Marketing und Design.",
    "founder": { "@type": "Person", "name": "Leon Schein" },
    "knowsAbout": ["Local SEO", "Suchmaschinenoptimierung", "Webdesign", "Google Ads", "Social Media Marketing", "Online Marketing", "Werbedesign", "Logodesign", "Marketingberatung"],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Leistungen",
      "itemListElement": SERVICES.map((s) => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": s.name,
          "description": s.text,
          ...(s.link && { "url": SITE_URL + s.link.href }),
        },
      })),
    },
    "priceRange": "€€",
    "sameAs": ["https://www.instagram.com/scheindigital"],
  },
  faqSchema(FAQ),
];
---

<BaseLayout
  title="Marketingagentur aus Schortens | ScheinDigital"
  description="Marketingbüro & Marketingagentur in Schortens: Websites, Google-Sichtbarkeit, Ads, Social Media & Design für mehr Anfragen. Kostenloses Erstgespräch."
  path="/"
  ogTitle="Marketingbüro & Marketingagentur Schortens | ScheinDigital"
  ogDescription="Mehr Sichtbarkeit. Mehr Anfragen. Mehr Kunden. Websites, Sichtbarkeit bei Google, Ads, Social Media und Design für Unternehmen."
  schema={SCHEMA}
>
  <div id="confirm-banner" class="confirm-banner" role="status" aria-live="polite">
    <span>Ihre Newsletter-Anmeldung wurde bestätigt. Willkommen bei ScheinDigital!</span>
    <button type="button" id="confirm-banner-close" aria-label="Schließen">&times;</button>
  </div>

  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <h1 class="hero-h1">Marketingagentur aus Schortens</h1>

        <p class="hero-claim"><span>Mehr Sichtbarkeit.</span> <span>Mehr Anfragen.</span> <span>Mehr Kunden.</span></p>

        <p class="subline">
          Ich finde heraus, wo Ihnen online Kunden verloren gehen, und setze die passende Lösung um.
        </p>

        <div class="buttons">
          <a class="primary" href={CAL_LINK} target="_blank" rel="noopener noreferrer">Kostenloses Erstgespräch buchen</a>
        </div>

        <p class="hero-note">Kostenlos und unverbindlich. 20 Minuten.</p>
      </div>

      <div class="hero-video">
        <div class="video-player" id="heroVideo">
          <button class="video-trigger" type="button" aria-label="Video abspielen">
            <img
              class="video-poster"
              src="/starter-poster.jpg"
              alt="Leon Schein von ScheinDigital, Marketingagentur aus Schortens"
              width="1280"
              height="720"
              loading="eager"
            />
            <span class="video-play-btn" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="leistungen" class="section">
    <p class="eyebrow">Leistungen</p>
    <h2>Wo hakt es bei Ihnen?</h2>

    <p class="section-intro">
      Oft liegt es nicht am Angebot, sondern daran, dass Kunden Sie online nicht finden oder nicht überzeugt werden.
    </p>

    <div class="grid">
      {SERVICES.map((s) => (
        <article class="card">
          <p class="card-problem">{s.problem}</p>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
          {s.link && <a class="card-link" href={s.link.href}>{s.link.text} →</a>}
        </article>
      ))}
    </div>
  </section>

  <ProcessSection heading="So läuft die Zusammenarbeit ab." steps={PROCESS} />

  <section id="ansprechpartner" class="section founder">
    <div class="founder-card">
      <div class="founder-copy">
        <p class="eyebrow">Ihr Ansprechpartner</p>
        <h2>Ein Ansprechpartner statt anonymer Agentur.</h2>

        <p>
          Ich bin Leon Schein und kümmere mich persönlich um Ihr Projekt, vom ersten Gespräch bis zur Umsetzung.
          Sie erreichen immer direkt mich, ohne Warteschleife und ohne wechselnde Zuständigkeiten.
        </p>

        <div class="founder-points">
          <span>Erst Analyse, dann Lösung</span>
          <span>Direkter Kontakt</span>
          <span>Ohne Knebelvertrag</span>
        </div>
      </div>

      <div class="founder-image">
        <img src="/leon-schein.webp" alt="Leon Schein, Gründer von ScheinDigital" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="standort" class="section location">
    <div class="location-card">
      <div class="location-copy">
        <p class="eyebrow">Standort</p>
        <h2>Ihr Marketingbüro in Schortens.</h2>
        <p>
          Als Marketingagentur aus Schortens kenne ich die Region von Jever über Sande bis Wilhelmshaven.
          Die Zusammenarbeit läuft flexibel digital, auch mit Unternehmen in ganz Deutschland.
        </p>
      </div>

      <div class="nap">
        <div>
          <span>Adresse</span>
          <strong>{ADDRESS.street}<br />{ADDRESS.postalCode} {ADDRESS.city}</strong>
        </div>
        <div>
          <span>Telefon</span>
          <strong><a href={PHONE.href}>{PHONE.display}</a></strong>
        </div>
      </div>
    </div>
  </section>

  <section id="newsletter" class="section newsletter-section">
    <div class="newsletter-card">
      <div class="newsletter-copy">
        <p class="eyebrow">Newsletter</p>
        <h2>Noch nicht bereit für ein Gespräch?</h2>
        <p>
          Dann erhalten Sie regelmäßig einen konkreten Tipp für mehr Sichtbarkeit und mehr Anfragen, direkt umsetzbar.
        </p>
      </div>

      <form class="newsletter-form" id="newsletter-form">
        <label class="sr-only" for="nl-email">E-Mail-Adresse</label>
        <input id="nl-email" type="email" name="email" placeholder="ihre@email.de" required />
        <button class="primary" type="submit">Eintragen</button>

        <label class="newsletter-consent">
          <input type="checkbox" id="nl-consent" name="consent" required />
          <span>
            Ja, ich möchte den Newsletter von ScheinDigital erhalten und habe die <a href="/rechtliches#datenschutz">Datenschutzerklärung</a>
            gelesen. Die Einwilligung
            kann ich jederzeit über den Abmeldelink widerrufen.
          </span>
        </label>

        <p class="newsletter-msg" id="newsletter-msg" role="status" aria-live="polite"></p>
        <p class="form-privacy">
          Sie erhalten eine E-Mail zur Bestätigung Ihrer Anmeldung (Double-Opt-In). Kein Spam,
          Abmeldung jederzeit möglich.
        </p>
      </form>
    </div>
  </section>

  <FaqSection items={FAQ} />

  <CtaSection
    heading="Wo verlieren Sie online Kunden?"
    lead="In 20 Minuten schaue ich mir Ihren Online-Auftritt an und sage Ihnen, wo es hakt."
    points={["Website-Check", "Google-Check", "Klare Empfehlung"]}
  />

  <script is:inline>
    // ============================================================
    //  Hero-Video: Klick-to-Play (lädt erst beim Klick → schnelle Ladezeit)
    // ============================================================
    (function () {
      const player = document.querySelector("#heroVideo");
      const trigger = player?.querySelector(".video-trigger");
      if (!player || !trigger) return;
      trigger.addEventListener(
        "click",
        () => {
          const video = document.createElement("video");
          video.src = "/starter.mp4";
          video.poster = "/starter-poster.jpg";
          video.controls = true;
          video.playsInline = true;
          video.setAttribute("playsinline", "");
          video.setAttribute("preload", "auto");
          trigger.replaceWith(video);
          video.play().catch(() => {});
        },
        { once: true }
      );
    })();

    // ============================================================
    //  Bestätigungs-Banner nach Double-Opt-In
    //  Wird angezeigt, wenn die URL ?newsletter=bestaetigt enthält
    //  (kommt von der Brevo-DOI-Weiterleitung)
    // ============================================================
    (function () {
      const params = new URLSearchParams(window.location.search);
      const banner = document.querySelector("#confirm-banner");
      if (params.get("newsletter") === "bestaetigt" && banner) {
        banner.classList.add("visible");
        // URL-Parameter sauber entfernen, damit das Banner bei Reload weg ist
        history.replaceState(null, "", window.location.pathname);
        // nach 8 Sekunden automatisch ausblenden
        setTimeout(() => banner.classList.remove("visible"), 8000);
      }
      document.querySelector("#confirm-banner-close")?.addEventListener("click", () => {
        banner?.classList.remove("visible");
      });
    })();

    // ============================================================
    //  Newsletter-Anmeldung -> n8n Webhook
    //  Trage unten deine n8n-Webhook-URL ein.
    //  (In n8n: Webhook-Node -> Methode POST -> Pfad z.B. /newsletter)
    // ============================================================
    const NEWSLETTER_WEBHOOK = "https://n8n.scheindigital.de/webhook/newsletter"; // <-- anpassen

    const nlForm = document.querySelector("#newsletter-form");
    const nlMsg = document.querySelector("#newsletter-msg");

    nlForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = new FormData(nlForm).get("email")?.toString().trim() || "";
      const consent = document.querySelector("#nl-consent")?.checked;
      if (!email) return;

      if (!consent) {
        nlMsg.textContent = "Bitte bestätigen Sie die Einwilligung, um fortzufahren.";
        nlMsg.className = "newsletter-msg error";
        return;
      }

      nlMsg.textContent = "Wird gesendet …";
      nlMsg.className = "newsletter-msg";

      try {
        const res = await fetch(NEWSLETTER_WEBHOOK, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            consent: true,
            consentText: "Newsletter-Einwilligung inkl. Datenschutzerklärung",
            source: "website-newsletter",
            timestamp: new Date().toISOString(),
          }),
        });

        if (!res.ok) throw new Error("Request failed");

        nlForm.reset();
        nlMsg.textContent = "Fast geschafft! Bitte bestätigen Sie den Link in Ihrer E-Mail.";
        nlMsg.className = "newsletter-msg ok";
      } catch (err) {
        nlMsg.textContent = "Da ist etwas schiefgelaufen. Bitte versuchen Sie es später erneut.";
        nlMsg.className = "newsletter-msg error";
      }
    });
  </script>
</BaseLayout>

<style>
  .confirm-banner {
    position: fixed;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2000;
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(640px, calc(100% - 40px));
    padding: 16px 20px;
    border-radius: 16px;
    background: rgba(0, 213, 213, 0.14);
    border: 1px solid rgba(0, 213, 213, 0.45);
    backdrop-filter: blur(18px);
    color: #f5f5f5;
    font-weight: 700;
    font-size: 0.98rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: top 0.4s ease, opacity 0.4s ease;
  }

  .confirm-banner.visible {
    top: 18px;
    opacity: 1;
  }

  .confirm-banner span {
    flex: 1;
  }

  .confirm-banner button {
    background: transparent;
    border: 0;
    color: #f5f5f5;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
    opacity: 0.7;
  }

  .confirm-banner button:hover {
    opacity: 1;
  }

  .hero-claim {
    max-width: 900px;
    font-size: clamp(2.2rem, 12cqi, 4.6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.07em;
    color: #ffffff;
    margin: 0;
  }

  .hero-claim span {
    display: block;
  }

  .hero-video {
    width: 100%;
    min-width: 0;
  }

  .video-player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    overflow: hidden;
    background: #000;
  }

  .video-trigger {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .video-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, filter 0.3s ease;
  }

  .video-trigger:hover .video-poster {
    transform: scale(1.03);
    filter: brightness(0.85);
  }

  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 76px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #00d5d5;
    color: #0a0a0a;
    box-shadow: 0 8px 30px rgba(0, 213, 213, 0.4);
    transition: transform 0.25s ease;
    padding-left: 4px;
  }

  .video-trigger:hover .video-play-btn {
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* :global, weil das Video erst per JavaScript eingefügt wird */
  .video-player :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }

  .founder-card {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 34px;
    align-items: center;
    background:
      radial-gradient(circle at top left, rgba(0, 213, 213, 0.16), transparent 34%),
      rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 34px;
    padding: 56px;
    overflow: hidden;
  }

  .founder-copy p {
    max-width: 720px;
  }

  .founder-image {
    border-radius: 30px;
    overflow: hidden;
    min-height: 440px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .founder-image img {
    width: 100%;
    height: 100%;
    min-height: 440px;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .location-card {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 40px;
    align-items: center;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 34px;
    padding: 54px;
  }

  .location-copy p {
    margin: 0;
    max-width: 640px;
  }

  .nap {
    display: grid;
    gap: 20px;
  }

  .nap span {
    display: block;
    color: #8d8d8d;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .nap strong {
    color: #f5f5f5;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  /* ---- Newsletter ---- */
  .newsletter-card {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 34px;
    align-items: center;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 30px;
    padding: 48px;
  }

  .newsletter-copy h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    margin-bottom: 16px;
  }

  .newsletter-copy p {
    margin: 0;
    max-width: 520px;
  }

  .newsletter-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
  }

  .newsletter-form input {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.055);
    color: #f5f5f5;
    border-radius: 999px;
    padding: 15px 18px;
    font: inherit;
    outline: none;
  }

  .newsletter-form input::placeholder {
    color: #777;
  }

  .newsletter-form input:focus {
    border-color: rgba(0, 213, 213, 0.55);
    box-shadow: 0 0 0 4px rgba(0, 213, 213, 0.08);
  }

  .newsletter-form .primary {
    white-space: nowrap;
  }

  .newsletter-consent {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 4px;
    cursor: pointer;
  }

  .newsletter-consent input {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: #00d5d5;
    cursor: pointer;
  }

  .newsletter-consent span {
    color: #bdbdbd;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .newsletter-consent a {
    color: #00d5d5;
  }

  .newsletter-msg {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    font-size: 0.92rem;
    min-height: 1.2em;
  }

  .newsletter-msg.ok {
    color: #00d5d5;
  }

  .newsletter-msg.error {
    color: #ff6b6b;
  }

  .form-privacy {
    grid-column: 1 / -1;
    margin: 6px 0 0;
    color: #8d8d8d;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  @media (max-width: 1000px) {
    .location-card,
    .newsletter-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 800px) {
    .founder-card,
    .location-card,
    .newsletter-card {
      grid-template-columns: 1fr;
      padding: 28px;
    }

    .founder-image,
    .founder-image img {
      min-height: 380px;
    }

    .newsletter-form {
      grid-template-columns: 1fr;
    }
  }
</style>
